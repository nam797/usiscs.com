{# Tracking numbers the distributor reported (PurchaseOrderShipment). #}
{% import 'admin/shared/_tracking.html.twig' as tracking %}
{% if field.value is empty %}
    <span class="text-secondary">None yet</span>
{% else %}
    <ul class="mb-0">
        {% for shipment in field.value %}
            <li>{{ tracking.link(shipment.trackingNumber, shipment.carrier) }} <span class="text-secondary">({{ shipment.createdAt|date('Y-m-d H:i') }})</span></li>
        {% endfor %}
    </ul>
{% endif %}
