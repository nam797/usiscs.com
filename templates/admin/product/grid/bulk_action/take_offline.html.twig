{# "Take offline" bulk action; see go_live.html.twig for how it works. #}
<form method="post" action="{{ path('app_admin_product_bulk_take_offline') }}" data-bulk-delete="index" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Controller\\Admin\\ProductGoLiveController::CSRF_TOKEN_ID')) }}">
    <button type="submit" class="btn btn-outline-secondary" disabled data-check-all-action="index" data-test-bulk-action="take-offline">
        {{ action.label|default('Take offline') }}
    </button>
</form>
