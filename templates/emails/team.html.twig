{# A staff email's plain text in the branded frame (App\Mail\TeamEmailBuilder). body_html is already escaped. #}
{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin: 0 0 16px; font-family: Arial, Helvetica, sans-serif; font-size: 20px; line-height: 1.3; color: #1B2A5E;">{{ heading }}</h1>
    <div style="font-size: 15px;">{{ body_html|raw }}</div>
{% endblock %}
