{# Pieces the email templates share, styled inline (see emails/layout.html.twig). #}

{% macro heading(text) %}
    <h1 style="margin: 0 0 16px; font-family: Arial, Helvetica, sans-serif; font-size: 24px; line-height: 1.3; color: #1B2A5E;">{{ text }}</h1>
{% endmacro %}

{% macro button(url, label) %}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 24px 0;">
        <tr>
            <td style="background: #8B1A1A;">
                <a href="{{ url }}" style="display: inline-block; padding: 14px 28px; font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; text-decoration: none;">{{ label }}</a>
            </td>
        </tr>
    </table>
{% endmacro %}

{% macro note(text) %}
    <p style="margin: 24px 0 0; font-size: 13px; color: #6b7280;">{{ text }}</p>
{% endmacro %}

{# The closing "questions? contact us" line customer emails end with. #}
{% macro help(question, hint = null) %}
    <p style="margin: 24px 0 0; font-size: 13px; color: #6b7280;">{{ question }} <a href="{{ url('app_shop_contact') }}" style="color: #8B1A1A;">Contact us</a>{% if hint %} and {{ hint }}{% endif %}.</p>
{% endmacro %}
