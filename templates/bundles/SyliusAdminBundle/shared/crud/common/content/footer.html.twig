{# Sylius's admin footer without its links (sylius.com, licence, source
   code, issue tracker: Sylius's own, not for the client's staff). Keeps the
   version line, handy when reporting a problem. #}
<footer class="footer footer-transparent d-print-none">
    <div class="container-xl">
        <div class="row text-center align-items-center">
            <div class="col-lg-12 ms-lg-auto">
                <ul class="list-inline list-inline-dots m-1">
                    <li class="list-inline-item">
                        {{ 'sylius.ui.powered_by'|trans }} Sylius v{{ sylius_meta.version }}.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</footer>
