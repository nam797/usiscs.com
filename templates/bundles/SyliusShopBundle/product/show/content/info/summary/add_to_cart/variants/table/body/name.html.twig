{# Sylius's variant row, plus what that variant's price is for ("per case of 144 pairs"). #}
{% set variant = hookable_metadata.context.variant %}
{% set product = hookable_metadata.context.product %}

<td>
    <div class="fw-semibold">{{ variant.name|default(variant.descriptor) }}</div>
    {% if variant.packUnit|default(null) %}
        <div class="small text-body-secondary" data-test-pack-unit>{{ variant.packUnit.perPrice }}</div>
    {% endif %}
    {% if product.hasOptions() %}
        <div>
            {% for option_value in variant.optionValues %}
                <span class="badge text-bg-light text-muted">
                    {{ option_value.value }}
                </span>
            {% endfor %}
        </div>
    {% endif %}
</td>
