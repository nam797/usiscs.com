{% import "@SyliusUi/macro/rtl.html.twig" as rtl %}

{% set generic_hook = 'sylius_shop.base' %}
{% set prefixes = prefixes|default([])|merge([generic_hook]) %}

<!DOCTYPE html>

<html lang="{{ app.request.locale|slice(0, 2) }}" data-bs-theme="dark" {{ rtl.default(sylius.localeCode) }}>
    <head>
        {% block metatags %}
            {% hook '#metatags' with { _prefixes: prefixes } %}
        {% endblock %}

        <title>{% block title %}{{ sylius.channel.name }}{% endblock %}</title>

        {#
            SEO baseline: Sylius's own #metatags hook (above) only emits
            charset/viewport/font-preload tags -- no meta description, no
            Open Graph/Twitter cards, no canonical URL, on any page, ever.
            Added directly here (rather than via the hook system) because
            `{% block %}` inheritance is how per-page overrides already
            work for <title> above -- a hooked template can't be
            overridden the same way by a page that merely extends this
            layout. Each page template sets {% block meta_description %};
            this falls back to a site-wide default when a page doesn't.
            The meta_description block below sits inside {% if false %} on
            purpose: a {% block %} tag always renders its own content in
            place, wherever it physically sits, as well as being reusable via
            block(). Left bare, the description text would print loose in
            <head> (browsers then end <head> early and move the tags after it
            into <body>). {% if false %} skips that in-place render while
            block('meta_description') still works. (It used to be wrapped in
            an HTML comment, which broke on a description containing "--".)

            block(...) output is printed |raw: whatever the page's block
            printed with {{ }} is already escaped once (a category called
            "Safety & PPE" arrives as "Safety &amp; PPE"), so escaping it
            again would show "&amp;" to search engines and in link previews.
            Fixed text in a block is ours.
        #}
        <meta name="description" content="{{ block('meta_description')|striptags|trim|raw }}">
        {# Without sorting/limit/search parameters: see App\Twig\SeoExtension. #}
        <link rel="canonical" href="{{ seo_canonical_url() }}">

        {% include 'shared/favicon.html.twig' %}

        {% if false %}{% block meta_description %}US Industrial Supply Chain Solutions protects customer uptime with just-in-time industrial supply, emergency sourcing, and dedicated account support for construction and industrial contractors nationwide.{% endblock %}{% endif %}

        {% block og_tags %}
            <meta property="og:type" content="{% block og_type %}website{% endblock %}">
            <meta property="og:site_name" content="{{ sylius.channel.name }}">
            <meta property="og:title" content="{{ block('title')|striptags|trim|raw }}">
            <meta property="og:description" content="{{ block('meta_description')|striptags|trim|raw }}">
            <meta property="og:url" content="{{ seo_canonical_url() }}">
            {% block og_extra %}{% endblock %}

            <meta name="twitter:card" content="summary">
            <meta name="twitter:title" content="{{ block('title')|striptags|trim|raw }}">
            <meta name="twitter:description" content="{{ block('meta_description')|striptags|trim|raw }}">
        {% endblock %}

        {# schema.org JSON-LD, per page type (App\Twig\StructuredDataExtension). #}
        {% block structured_data %}{% endblock %}

        {% block stylesheets %}
            {% hook '#stylesheets' with { _prefixes: prefixes } %}
        {% endblock %}

        {% hook 'head' with { _prefixes: prefixes } %}
    </head>

    <body data-route="{{ app.request.attributes.get('_route') }}">
        {% block body %}
            <div class="{% apply escape %}{% hook '#body_classes' with { _prefixes: prefixes } %}{% endapply %}">
                {% block header %}
                    {% hook 'header' with { _prefixes: prefixes } %}
                {% endblock %}

                {% block content %}{% endblock %}

                {% block footer %}
                    {% hook 'footer' with { _prefixes: prefixes } %}
                {% endblock %}
            </div>
            {% hook 'offcanvas' with { _prefixes: prefixes } %}
        {% endblock %}

        {% block javascripts %}
            {% hook '#javascripts' with { _prefixes: prefixes } %}
        {% endblock %}
    </body>
</html>
