{% import "@SyliusUi/macro/rtl.html.twig" as rtl %}

{% set generic_hook = 'sylius_shop.base' %}
{% set prefixes = prefixes|default([])|merge([generic_hook]) %}

<!DOCTYPE html>

<html lang="{{ app.request.locale|slice(0, 2) }}" data-bs-theme="dark" {{ rtl.default(sylius.localeCode) }}>
    <head>
        {% block metatags %}
            {% hook '#metatags' with { _prefixes: prefixes } %}
        {% endblock %}

        <title>{% block title %}{{ sylius.channel.name }}{% endblock %}</title>

        {#
            SEO baseline: Sylius's own #metatags hook (above) only emits
            charset/viewport/font-preload tags -- no meta description, no
            Open Graph/Twitter cards, no canonical URL, on any page, ever.
            Added directly here (rather than via the hook system) because
            `{% block %}` inheritance is how per-page overrides already
            work for <title> above -- a hooked template can't be
            overridden the same way by a page that merely extends this
            layout. Each page template sets {% block meta_description %};
            this falls back to a site-wide default when a page doesn't.
            The block tag below is wrapped in an HTML comment on purpose:
            a {% block %} tag always renders its own content in place,
            wherever it physically sits, in addition to being reusable via
            block(). Left bare, that printed the raw description text as
            loose text in <head>, which broke HTML parsing (browsers end
            <head> on the first non-whitespace text and move everything
            after -- including the following <meta property="og:..."> tags
            -- into <body>, where the stray text then rendered visibly at
            the top of every page). The comment hides that in-place render
            while leaving the block fully overridable per page and still
            usable via block('meta_description') below.
        #}
        <meta name="description" content="{{ block('meta_description')|striptags|trim }}">
        <link rel="canonical" href="{{ app.request.uri }}">

        <!-- {% block meta_description %}US Industrial Supply Chain Solutions protects customer uptime with just-in-time industrial supply, emergency sourcing, and dedicated account support for construction and industrial contractors nationwide.{% endblock %} -->

        {% block og_tags %}
            <meta property="og:type" content="website">
            <meta property="og:site_name" content="{{ sylius.channel.name }}">
            <meta property="og:title" content="{{ block('title')|striptags|trim }}">
            <meta property="og:description" content="{{ block('meta_description')|striptags|trim }}">
            <meta property="og:url" content="{{ app.request.uri }}">

            <meta name="twitter:card" content="summary">
            <meta name="twitter:title" content="{{ block('title')|striptags|trim }}">
            <meta name="twitter:description" content="{{ block('meta_description')|striptags|trim }}">
        {% endblock %}

        {% block stylesheets %}
            {% hook '#stylesheets' with { _prefixes: prefixes } %}
        {% endblock %}

        {% hook 'head' with { _prefixes: prefixes } %}
    </head>

    <body data-route="{{ app.request.get('_route') }}">
        {% block body %}
            <div class="{% apply escape %}{% hook '#body_classes' with { _prefixes: prefixes } %}{% endapply %}">
                {% block header %}
                    {% hook 'header' with { _prefixes: prefixes } %}
                {% endblock %}

                {% block content %}{% endblock %}

                {% block footer %}
                    {% hook 'footer' with { _prefixes: prefixes } %}
                {% endblock %}
            </div>
            {% hook 'offcanvas' with { _prefixes: prefixes } %}
        {% endblock %}

        {% block javascripts %}
            {% hook '#javascripts' with { _prefixes: prefixes } %}
        {% endblock %}
    </body>
</html>
