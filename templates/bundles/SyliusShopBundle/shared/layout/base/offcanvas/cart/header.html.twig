{# Sylius's cart slide-out title was an <h1>, giving every page a second
   H1 ("Cart") after the real heading. Same look, not a heading. #}
<div class="offcanvas-header">
    <div class="offcanvas-title fs-5 fw-bold">{{ 'sylius.ui.cart'|trans }}</div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
</div>
