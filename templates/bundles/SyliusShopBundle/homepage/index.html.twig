{#
    Full override of Sylius's own homepage/index.html.twig. The vendor
    version is a thin hook wrapper around catalog widgets (banner.html.twig,
    new_collection.html.twig) that don't apply here -- this is a fully
    custom marketing homepage, carried over from the live usiscs.com
    homepage, so it's simplest as a plain template like /quote and
    /contact rather than fighting the hook system for content that isn't
    catalog-related.

    Supplies first (client feedback, 2026-11-20): a short hero, then a tile
    per category, then a shortened version of the services marketing
    carried over from the old live site (the full story is on /services
    and /about). Hero copy is new and still needs the client's sign-off.
    Stats bar figures (500+ / 48hr / 100% / 1 Call) were confirmed by
    watching the live page's JS count-up animation finish in a browser
    (2026-10-21), not inferred.
#}
{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ sylius.channel.name }} — Protecting Customer Uptime{% endblock %}

{% block meta_description %}We deliver the industrial supplies you need, on time, every time — and we solve supply failures before they cost you uptime. 500+ vendor partners, 48-hour emergency sourcing.{% endblock %}

{# Who runs the site, for search results and the knowledge panel. #}
{% block structured_data %}
    {{ json_ld(ld_organization(sylius.channel, absolute_url(asset('build/app/shop/images/logo.png', 'app.shop'))), ld_website(sylius.channel)) }}
{% endblock %}

{% block content %}
{# Icon per department code (local SVGs in assets/icons/category, Tabler
   icons); any other department gets the cube. #}
{% set category_icons = {
    safety_ppe: 'category:helmet',
    tools: 'category:tool',
    janitorial_facility: 'category:spray',
    welding: 'category:flame',
    lubricants_chemicals_paint: 'category:droplet',
    fasteners_tape_material_handling: 'category:nut',
    abrasives: 'category:disc',
} %}
<div class="container py-5">

    {# Hero #}
    <div class="row mb-4">
        <div class="col-lg-9 mx-auto text-center">
            <h1 class="display-5 mb-3">Industrial Supplies, Delivered.</h1>
            <p class="text-secondary mb-4 fs-5">
                Safety gear, tools, welding, janitorial and shop supplies, ready to order
                online.
            </p>
            <div class="d-flex gap-3 justify-content-center align-items-center flex-wrap">
                <a href="#categories" class="btn btn-primary">Shop Supplies</a>
                <a href="{{ path('app_shop_rfq') }}" class="btn btn-link">Need a quote?</a>
            </div>
        </div>
    </div>

    {# Departments: the main thing on the page. One with nothing in it yet
       asks for a quote instead, and the last tile is for anything not
       listed (what "Specialty & Hard-to-Find" was). #}
    <section id="categories" class="mb-5" aria-labelledby="categories-heading">
        <h2 id="categories-heading" class="visually-hidden">Shop by category</h2>
        <div class="row g-3">
            {% for category in shop_categories() %}
                {% set taxon = category.taxon %}
                <div class="col-6 col-lg-3">
                    {% if category.products > 0 %}
                        <a class="category-tile" href="{{ path('sylius_shop_product_index', { slug: taxon.slug, _locale: taxon.translation.locale }) }}">
                            {{ ux_icon(category_icons[taxon.code] ?? 'tabler:cube', { class: 'category-tile__icon', 'aria-hidden': 'true' }) }}
                            <span class="category-tile__name">{{ taxon.name }}</span>
                            <span class="category-tile__count">{{ category.products|number_format }} products</span>
                        </a>
                    {% else %}
                        <a class="category-tile category-tile--ask" href="{{ path('app_shop_rfq') }}">
                            {{ ux_icon('category:zoom-question', { class: 'category-tile__icon', 'aria-hidden': 'true' }) }}
                            <span class="category-tile__name">{{ taxon.name }}</span>
                            <span class="category-tile__count">Can't find it? Ask us &rarr;</span>
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
            <div class="col-6 col-lg-3">
                <a class="category-tile category-tile--ask" href="{{ path('app_shop_rfq') }}">
                    {{ ux_icon('category:zoom-question', { class: 'category-tile__icon', 'aria-hidden': 'true' }) }}
                    <span class="category-tile__name">Specialty &amp; Hard-to-Find</span>
                    <span class="category-tile__count">Can't find it? Ask us &rarr;</span>
                </a>
            </div>
        </div>
    </section>

    {# Stats bar #}
    <div class="row text-center mb-5 py-4" style="border-top: 1px solid var(--bs-border-color); border-bottom: 1px solid var(--bs-border-color);">
        <div class="col-6 col-md-3 mb-3 mb-md-0">
            <div class="h2 font-display mb-0">500+</div>
            <div class="text-secondary small">Vendor Partners</div>
        </div>
        <div class="col-6 col-md-3 mb-3 mb-md-0">
            <div class="h2 font-display mb-0">48hr</div>
            <div class="text-secondary small">Emergency Sourcing</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="h2 font-display mb-0">100%</div>
            <div class="text-secondary small">Uptime Focus</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="h2 font-display mb-0">1 Call</div>
            <div class="text-secondary small">Any Problem Solved</div>
        </div>
    </div>

    {# What We Do, shortened: the full list is on /services #}
    <div class="row mb-4">
        <div class="col-lg-8 mx-auto text-center">
            <span class="eyebrow">What We Do</span>
            <h2 class="mb-0">Built to Keep You Running.</h2>
        </div>
    </div>
    <div class="row g-4 mb-3">
        {% for item in [
            { title: 'Just-in-Time Industrial Supply', body: 'MRO materials, consumables, tools, safety products, and replacement parts delivered when needed.' },
            { title: 'Supply Problem Solving', body: 'Sourcing hard-to-find items and approved substitutes through our vendor network.' },
            { title: 'Dedicated Account Support', body: 'A named team for quoting, communication, escalation, and billing.' },
            { title: 'Equipment Repair & Maintenance', body: 'Small engines, heavy equipment and preventative maintenance, on-site or in-shop.' },
        ] %}
            <div class="col-md-6 col-lg-3">
                <div class="content-card">
                    <h3 class="h6">{{ item.title }}</h3>
                    <p class="text-secondary small mb-0">{{ item.body }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
    <div class="row mb-5">
        <div class="col-12 text-center">
            <a href="{{ path('app_shop_services') }}" class="btn btn-link">View All Services &rarr;</a>
        </div>
    </div>

    {# Closing CTA #}
    <div class="row">
        <div class="col-lg-8 mx-auto text-center">
            <h2 class="mb-3">One Call. Any Supply Problem. Solved.</h2>
            <p class="text-secondary mb-4">
                Can't find what you need in the shop? Tell us -- we'll source it and get it delivered.
            </p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="{{ path('app_shop_rfq') }}" class="btn btn-primary">Request a Quote</a>
                <a href="{{ path('app_shop_contact') }}" class="btn btn-outline-secondary">Contact Us</a>
            </div>
        </div>
    </div>

</div>
{% endblock %}
