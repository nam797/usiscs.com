{# Admin (staff) password reset link. #}
{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}Reset your US Industrial Supply admin password{% endblock %}

{% block content %}
    {# Imported in the block: Sylius renders the blocks, never the template's body. #}
    {% import 'emails/_macros.html.twig' as mail %}
    {{ mail.heading('Reset your admin password') }}
    <p style="margin: 0;">Hello {{ adminUser.firstName ?: adminUser.username }}, we got a request to reset your admin password.</p>
    {% if resetUrl is not null %}
        {{ mail.button(resetUrl, 'Reset your password') }}
    {% else %}
        <p style="margin: 16px 0 0;">Your reset code: <strong>{{ adminUser.passwordResetToken }}</strong></p>
    {% endif %}
    {{ mail.note("If you didn't ask for this, tell IT support. Your password stays the same.") }}
{% endblock %}
