{# Shop customer password reset link. #}
{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}Reset your US Industrial Supply password{% endblock %}

{% block content %}
    {# Imported in the block: Sylius renders the blocks, never the template's body. #}
    {% import 'emails/_macros.html.twig' as mail %}
    {{ mail.heading('Reset your password') }}
    <p style="margin: 0;">We got a request to reset the password for <strong>{{ user.username }}</strong>. Choose a new one here:</p>
    {{ mail.button(url('sylius_shop_password_reset', {token: user.passwordResetToken}), 'Reset your password') }}
    {{ mail.note("If you didn't ask for this, you can ignore this email. Your password stays the same.") }}
{% endblock %}
