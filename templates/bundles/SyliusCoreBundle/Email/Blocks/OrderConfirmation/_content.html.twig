{# Order confirmation: what was ordered, the totals and where it's going. #}
{% import 'emails/_macros.html.twig' as mail %}
{% set money = order.currencyCode %}
{% set customer = order.customer %}
{% set address = order.shippingAddress %}

{{ mail.heading('Thanks for your order' ~ (customer and customer.firstName ? ', ' ~ customer.firstName : '') ~ '!') }}
<p style="margin: 0 0 8px;">We've received order <strong>{{ order.number }}</strong> and are getting it ready. We'll email you again when it ships, with tracking.</p>

{% if order.tokenValue %}{{ mail.button(url('sylius_shop_order_show', {tokenValue: order.tokenValue}), 'View your order') }}{% endif %}

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse: collapse; font-size: 14px;">
    <tr>
        <th align="left" style="padding: 8px 0; border-bottom: 2px solid #1B2A5E; color: #1B2A5E;">Item</th>
        <th align="center" style="padding: 8px; border-bottom: 2px solid #1B2A5E; color: #1B2A5E;">Qty</th>
        <th align="right" style="padding: 8px 0; border-bottom: 2px solid #1B2A5E; color: #1B2A5E;">Total</th>
    </tr>
    {% for item in order.items %}
        <tr>
            <td style="padding: 10px 0; border-bottom: 1px solid #e5e7eb;">
                {{ item.productName }}
                {% if item.variantName and item.variantName != item.productName %}<br><span style="color: #6b7280;">{{ item.variantName }}</span>{% endif %}
                {% if item.variant and item.variant.code %}<br><span style="color: #6b7280; font-size: 12px;">SKU {{ item.variant.code }}</span>{% endif %}
            </td>
            <td align="center" style="padding: 10px 8px; border-bottom: 1px solid #e5e7eb;">{{ item.quantity }}</td>
            <td align="right" style="padding: 10px 0; border-bottom: 1px solid #e5e7eb; white-space: nowrap;">{{ item.subtotal|sylius_format_money(money, localeCode) }}</td>
        </tr>
    {% endfor %}
    <tr>
        <td colspan="2" align="right" style="padding: 10px 8px 2px;">Items</td>
        <td align="right" style="padding: 10px 0 2px; white-space: nowrap;">{{ order.itemsSubtotal|sylius_format_money(money, localeCode) }}</td>
    </tr>
    {% set discount = order.orderPromotionTotal %}
    {% if discount != 0 %}
        <tr>
            <td colspan="2" align="right" style="padding: 2px 8px;">Discount</td>
            <td align="right" style="padding: 2px 0; white-space: nowrap;">{{ discount|sylius_format_money(money, localeCode) }}</td>
        </tr>
    {% endif %}
    <tr>
        <td colspan="2" align="right" style="padding: 2px 8px;">Shipping</td>
        <td align="right" style="padding: 2px 0; white-space: nowrap;">{{ order.shippingTotal|sylius_format_money(money, localeCode) }}</td>
    </tr>
    {% if order.taxTotal != 0 %}
        <tr>
            <td colspan="2" align="right" style="padding: 2px 8px;">Tax</td>
            <td align="right" style="padding: 2px 0; white-space: nowrap;">{{ order.taxTotal|sylius_format_money(money, localeCode) }}</td>
        </tr>
    {% endif %}
    <tr>
        <td colspan="2" align="right" style="padding: 8px 8px 0; font-weight: bold; color: #1B2A5E;">Total</td>
        <td align="right" style="padding: 8px 0 0; font-weight: bold; color: #1B2A5E; white-space: nowrap;">{{ order.total|sylius_format_money(money, localeCode) }}</td>
    </tr>
</table>

{% if address %}
    <p style="margin: 24px 0 0; font-size: 14px;">
        <strong style="color: #1B2A5E;">Shipping to</strong><br>
        {{ address.firstName }} {{ address.lastName }}<br>
        {% if address.company %}{{ address.company }}<br>{% endif %}
        {{ address.street }}<br>
        {{ address.city }}, {{ address.provinceName ?: address.provinceCode }} {{ address.postcode }}
    </p>
{% endif %}

{{ mail.help('Questions about your order?', 'quote order ' ~ order.number) }}
