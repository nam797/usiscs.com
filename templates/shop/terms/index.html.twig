{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Terms of Service | {{ parent() }}{% endblock %}

{% block meta_description %}Terms of Service for US Industrial Supply Chain Solutions, covering payment, service timelines, returns, and refunds.{% endblock %}

{% block content %}
<div class="container py-5">

    <div class="row mb-5">
        <div class="col-lg-8 mx-auto text-center">
            <span class="eyebrow">Legal</span>
            <h1 class="display-6 mb-2">Terms of Service</h1>
            <p class="text-secondary small mb-0">Last updated: June 2026</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">

            <h2 class="h4">Payment</h2>
            <p class="text-secondary">
                Payments may be processed through Elavon or another authorized payment
                processor. By placing an order or approving service, the customer authorizes
                the transaction before work begins.
            </p>

            <h2 class="h4 mt-4">Service Timeline</h2>
            <p class="text-secondary">
                Our standard service level is five (5) business days after all required
                information, approvals, payment authorization, and materials have been
                received. Supplier delays, shipping delays, weather, and customer-caused
                delays can extend this timeline.
            </p>

            <h2 class="h4 mt-4">Returns</h2>
            <p class="text-secondary">
                Returns may be accepted if initiated within 30 days of purchase. All approved
                returns are subject to a 15% restocking fee. Returned items must be unused,
                undamaged, complete, and in resalable condition.
            </p>

            <h2 class="h4 mt-4">Refunds</h2>
            <p class="text-secondary">
                Refunds are reviewed and approved on a case-by-case basis. Approved refunds may
                be reduced by restocking, processing, shipping, labor, and other
                non-recoverable costs.
            </p>

            <h2 class="h4 mt-4">Non-Returnable Items</h2>
            <p class="text-secondary">
                Custom-made items, fabricated parts, special-order items, installed or used
                products, completed labor, diagnostic services, and delivery or shipping
                charges are not eligible for return.
            </p>

            <h2 class="h4 mt-4">Customer Agreement</h2>
            <p class="text-secondary">
                Placing an order, approving service, or submitting payment means the customer
                acknowledges and agrees to this policy in full.
            </p>

            <h2 class="h4 mt-4">Questions?</h2>
            <p class="text-secondary mb-0">
                Contact us at <a href="mailto:operations@usiscs.com">operations@usiscs.com</a>
                or <a href="tel:+19126657257">1-912-665-7257</a>, Monday&ndash;Friday, 6AM&ndash;6PM EST.
            </p>

        </div>
    </div>

</div>
{% endblock %}
