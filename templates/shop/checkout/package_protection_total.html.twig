{# Package protection in the checkout sidebar totals, under shipping, once it's charged. #}
{% import "@SyliusShop/shared/macro/money.html.twig" as money %}
{% set order = hookable_metadata.context.order %}
{% if order.packageProtectionTotal is defined and order.packageProtectionTotal != 0 %}
    <tr data-test-package-protection-total>
        <td>Package protection:</td>
        <td class="text-end">{{ money.convertAndFormat(order.packageProtectionTotal) }}</td>
    </tr>
{% endif %}
