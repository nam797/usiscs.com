includes:
    # composer.json disables phpstan/extension-installer in allow-plugins, so the
    # installed extensions have to be included by hand. Without phpstan-doctrine
    # PHPStan does not know Doctrine assigns entity #[ORM\Id] properties by
    # reflection and reports them as never written.
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-webmozart-assert/extension.neon

parameters:
    level: 9
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony on cache warmup (gitignored); its config
        # shapes don't always parse.
        - config/reference.php
    doctrine:
        objectManagerLoader: tests/object-manager.php
